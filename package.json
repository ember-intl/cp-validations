{
  "name": "@ember-intl/cp-validations",
  "version": "7.0.2",
  "description": "ember-intl support for ember-cp-validations",
  "keywords": [
    "ember-addon",
    "ember-cp-validations",
    "ember-intl",
    "ember-validation",
    "i18n",
    "internationalization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-intl/cp-validations.git"
  },
  "license": "MIT",
  "author": "jason.mitchell.w@gmail.com",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment production",
    "build:test": "ember build --environment test --output-path dist-for-testing",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "release:prepare": "changeset version",
    "release:package": "changeset publish",
    "start": "ember serve",
    "test": "pnpm build:test && ember-test --path dist-for-testing --port 0"
  },
  "dependencies": {
    "@babel/core": "^7.24.7",
    "ember-auto-import": "^2.7.4",
    "ember-cli-babel": "^8.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ember-intl/v1-compat": "^2.0.6",
    "@ember/optional-features": "^2.1.0",
    "@ember/test-helpers": "^5.7.0",
    "@embroider/test-setup": "^4.0.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@ijlee2-frontend-configs/changesets": "^3.0.4",
    "@ijlee2-frontend-configs/eslint-config-ember": "^4.8.1",
    "@ijlee2-frontend-configs/prettier": "^3.4.4",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^8.2.2",
    "ember-cli": "~6.12.0",
    "ember-cli-dependency-checker": "^3.3.2",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-cp-validations": "^7.0.0",
    "ember-intl": "^9.3.2",
    "ember-load-initializers": "^2.1.2",
    "ember-page-title": "^8.2.3",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^11.0.1",
    "ember-source": "~6.12.1",
    "ember-testem": "^0.3.3",
    "eslint": "^10.13.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.9.10",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.2.0",
    "typescript": "^6.0.3",
    "webpack": "^5.112.0"
  },
  "peerDependencies": {
    "ember-cp-validations": "^7.0.0",
    "ember-intl": "^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "ember-cp-validations": {
      "optional": false
    },
    "ember-intl": {
      "optional": false
    }
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "after": [
      "ember-cp-validations"
    ]
  }
}
